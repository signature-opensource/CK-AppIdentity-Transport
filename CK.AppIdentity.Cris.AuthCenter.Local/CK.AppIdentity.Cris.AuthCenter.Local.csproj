<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CK.AppIdentity.Cris.AuthCenter</RootNamespace>
    <Description>The Local side of the "AuthCenter" feature: this application is the AuthCenter of its local parties (its settings, its sessions, the signing of its tokens, the login handlers and the handling of the commands relayed by its fronts).</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CK.AppIdentity.Cris.AuthCenter.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- For the Basic and Weak login handlers (AuthCenterLoginHandlers.cs): temporary, until the old stack is retired. -->
    <PackageReference Include="CK.IO.Authentication.Basic" Version="2.0.2-0.cris-auth.0.ci.9" />
    <PackageReference Include="CK.IO.Authentication.Weak" Version="2.0.2-0.cris-auth.0.ci.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.AppIdentity.Cris.AuthCenter\CK.AppIdentity.Cris.AuthCenter.csproj" />
  </ItemGroup>
</Project>
